FASTAPI_APP_NAME=fastapi-service
FASTAPI_DEBUG=false
FASTAPI_API_PREFIX=/api/v1
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=false
FASTAPI_CORS_ORIGINS=["http://localhost:3000"]

# Generate a unique secret (e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))')
# and set FASTAPI_JWT_SECRET to it. Share the same secret across all app replicas.
# Without it, a random key is generated at each process start.
# FASTAPI_JWT_SECRET=
FASTAPI_JWT_EXPIRE_MINUTES=30
FASTAPI_DB_POOL_SIZE=5
FASTAPI_DB_MAX_OVERFLOW=10

# SQLAlchemy URL. Use the "postgresql+psycopg://" driver (async capable);
# "postgresql+asyncpg://" also works if you prefer asyncpg.
FASTAPI_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/fastapi_service
FASTAPI_DB_ECHO=false
FASTAPI_DB_CHECK_ON_STARTUP=true

# Host ports published by Docker Compose.
POSTGRES_PORT=5433
APP_PORT=8000
